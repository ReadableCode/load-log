APP_ENV=development

# Alembic migrations and the test suite connect to Postgres directly. Point
# these at the shared Postgres host (the same one the prod compose runs).
POSTGRES_URL=<host-or-ip-of-shared-postgres>
POSTGRES_PORT=5432
POSTGRES_DB=load_log
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>

# Both clients (Streamlit web app AND the TUI) reach data through PostgREST and
# log in through the shared auth service to get a JWT — neither touches Postgres
# directly. In the prod compose these point at the in-network containers; for the
# local dev stack (docker-compose.dev.yml) they point at the dev containers.
POSTGREST_URL=https://pgrest.tinkernet.me
AUTH_URL=https://auth.tinkernet.me

# The TUI is non-interactive: it reads these at startup, logs in, and uses the
# returned JWT for every request. Must match a row in load_log.users.
LOAD_LOG_USERNAME=<your-username>
LOAD_LOG_PASSWORD=<your-password>
