# --- self-contained stack (compose.yaml): only these three are needed ---
# letters and digits only (they go into a connection URL and SQL);
# generate each with `openssl rand -hex 32`. compose.yaml sets every other
# key below itself; the rest of this file is for running against an existing
# Postgres and PostgREST (compose.external.yaml, or bare-metal).
# POSTGRES_PASSWORD=
# POSTGREST_DB_PASSWORD=
# POSTGREST_JWT_SECRET=            # 32+ characters
# LOAD_LOG_PORT=8505               # host port, both compose files

APP_ENV=development

# Superuser connection to the shared Postgres (the same one the prod compose
# runs). Login in both clients (Streamlit web app AND the TUI) reads
# load_log.users over it; the startup schema bootstrap, the test suite and
# scripts/ use it too. Application data never goes through it.
POSTGRES_URL=<host-or-ip-of-shared-postgres>
POSTGRES_PORT=5432
POSTGRES_DB=apps
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>

# PostgREST's JWT secret (its PGRST_JWT_SECRET). Login runs in-process (the
# postgrest-auth library) in both clients and signs the session JWT with it.
# JWT_SECRET is accepted as a fallback name.
POSTGREST_JWT_SECRET=<postgrest-jwt-secret>

# Both clients reach data through PostgREST with the JWT from login. In the prod
# compose and in compose.yaml it is the in-network postgrest container, set by
# the compose file. compose.external.yaml requires it. Unset on bare-metal, the
# clients fall back to the author's own deployment (default in
# backend/src/api_client.py).
POSTGREST_URL=https://pgrest.example.com

# The TUI is non-interactive: it reads these at startup, logs in, and uses the
# returned JWT for every request. Must match a row in load_log.users.
LOAD_LOG_USERNAME=<your-username>
LOAD_LOG_PASSWORD=<your-password>
