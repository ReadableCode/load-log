APP_ENV=development

# Load Log always connects to the shared Postgres — whether you run bare-metal,
# in the portable docker-compose, or in the prod compose. There is no local DB.
# Point these at the shared Postgres host (the same one the prod compose runs).
POSTGRES_URL=<host-or-ip-of-shared-postgres>
POSTGRES_PORT=5432
POSTGRES_DB=load_log
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>
